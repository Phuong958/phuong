    private void btnDangNhapActionPerformed(java.awt.event.ActionEvent evt) {                                            
        
        String taiKhoan = txtTaiKhoan.getText().trim();
        String matKhau = new String(txtMatKhau.getPassword());
        String quyen = cbQuyen.getSelectedItem().toString();

        if (taiKhoan.isEmpty()) {
            JOptionPane.showMessageDialog( this, "Vui lòng nhập tài khoản!" );
            txtTaiKhoan.requestFocus();
            return;
        }

        if (matKhau.isEmpty()) {
            JOptionPane.showMessageDialog( this, "Vui lòng nhập mật khẩu!" );
            txtMatKhau.requestFocus();
            return;
        }

        if (taiKhoan.equals("admin") && matKhau.equals("123456") && quyen.equals("Admin")) {
            JOptionPane.showMessageDialog( this, "Đăng nhập thành công!");
        } else {
            JOptionPane.showMessageDialog( this, "Sai tài khoản, mật khẩu hoặc quyền!");
        }
    }                                           

    private void btnNhapActionPerformed(java.awt.event.ActionEvent evt) {                                        

        txtMatKhau.setText("");
        cbQuyen.setSelectedIndex(0);
        chkGhiNho.setSelected(false);

        txtTaiKhoan.requestFocus();
    }                                       

    private void btnThoatActionPerformed(java.awt.event.ActionEvent evt) {                                         

        int luaChon = JOptionPane.showConfirmDialog( this, "Bạn có muốn thoát không?", "Xác nhận", JOptionPane.YES_NO_OPTION );

        if (luaChon == JOptionPane.YES_OPTION) {
            System.exit(0);
        }
    }                                        

    
