package baitapchuong2;
import java.util.Scanner;

public class lab1 {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // 1. NHẬP THÔNG TIN
        System.out.print("Nhap ma sinh vien: ");
        String maSV = sc.nextLine();

        System.out.print("Nhap ho ten: ");
        String hoTen = sc.nextLine();

        // Nhập điểm chuyên cần
        double chuyenCan = nhapDiem(sc, "Nhap diem chuyen can: ");
        // Nhập điểm giữa kỳ
        double giuaKy = nhapDiem(sc, "Nhap diem giua ky: ");
        // Nhập điểm cuối kỳ
        double cuoiKy = nhapDiem(sc, "Nhap diem cuoi ky: ");

        // 2. TÍNH ĐIỂM TỔNG KẾT
        double tongKet = chuyenCan * 0.1 + giuaKy * 0.3 + cuoiKy * 0.6;

        // 3. XẾP LOẠI
        String xepLoai;

        if (tongKet >= 8.5) {
            xepLoai = "A";
        } else if (tongKet >= 7.0) {
            xepLoai = "B";
        } else if (tongKet >= 5.5) {
            xepLoai = "C";
        } else if (tongKet >= 4.0) {
            xepLoai = "D";
        } else {
            xepLoai = "F";
        }

        // 4. HIỂN THỊ KẾT QUẢ
        System.out.println("\n========== KET QUA ==========");

        System.out.println("Ma sinh vien: " + maSV);
        System.out.println("Ho ten: " + hoTen);

        System.out.println("Diem chuyen can: " + chuyenCan);
        System.out.println("Diem giua ky: " + giuaKy);
        System.out.println("Diem cuoi ky: " + cuoiKy);

        System.out.printf("Diem tong ket: %.2f%n", tongKet);
        System.out.println("Xep loai: " + xepLoai);
    }

    // HÀM NHẬP ĐIỂM
    public static double nhapDiem(Scanner sc, String thongBao) {

        double diem;

        while (true) {

            System.out.print(thongBao);
            diem = sc.nextDouble();
            // Kiểm tra điểm
            if (diem >= 0 && diem <= 10) {
                return diem;
            }
            System.out.println("Diem khong hop le!");
            System.out.println("Vui long nhap diem tu 0 den 10.");
        }
    }
}
