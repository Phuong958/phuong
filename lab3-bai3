    private void btnGiaiActionPerformed(java.awt.event.ActionEvent evt) {                                        
                try {

            double a = Double.parseDouble(txtSothunhat.getText());
            double b = Double.parseDouble(txtSothuhai.getText());

            if (a != 0) {

                double x = -b / a;

                JOptionPane.showMessageDialog(
                        this,
                        "Phuong trinh co mot nghiem:\nx = " + x,
                        "Ket qua",
                        JOptionPane.INFORMATION_MESSAGE
                );

            }
            else if (b != 0) {

                JOptionPane.showMessageDialog(
                        this,
                        "Phuong trinh vo nghiem!",
                        "Ket qua",
                        JOptionPane.INFORMATION_MESSAGE
                );

            }
            else {

                JOptionPane.showMessageDialog(
                        this,
                        "Phuong tranh co vo so nghiem!",
                        "Ket qua",
                        JOptionPane.INFORMATION_MESSAGE
                );
            }
        } catch (NumberFormatException e) {

            JOptionPane.showMessageDialog(
                    this,
                    "Vui long nhap a và b là so!",
                    "Loi",
                    JOptionPane.ERROR_MESSAGE
            );
        }
    }                                       

