    private void btnhienthiActionPerformed(java.awt.event.ActionEvent evt) {                                           
                    
            try {

            int n = Integer.parseInt(txtnhapn.getText());

            if (n <= 0) {

                JOptionPane.showMessageDialog(
                        this,
                        "n phải là số nguyên dương!",
                        "Lỗi",
                        JOptionPane.WARNING_MESSAGE
                );
                return;
            }

            long a = 0;
            long b = 1;

            StringBuilder ketQua = new StringBuilder();

            for (int i = 0; i < n; i++) {

                ketQua.append(a);

                if (i < n - 1) {
                    ketQua.append(" ");
                }
                long c = a + b;

                a = b;
                b = c;
            }

            txtketqua.setText(ketQua.toString());

        } catch (NumberFormatException e) {

            JOptionPane.showMessageDialog(
                    this,
                    "Vui lòng nhập n là số nguyên!",
                    "Lỗi",
                    JOptionPane.ERROR_MESSAGE
            );
        }
    }                                          

