    private void luuDuLieu() {

    try (ObjectOutputStream out =
            new ObjectOutputStream(
                new FileOutputStream(FILE_DATA))) {

        out.writeObject(danhSach);

    } catch (IOException e) {

        JOptionPane.showMessageDialog(
            this,
            "Lỗi lưu dữ liệu: " + e.getMessage()
        );
    }
}
    
    private void docDuLieu() {

    try (ObjectInputStream in =
            new ObjectInputStream(
                new FileInputStream(FILE_DATA))) {

        danhSach =
            (List<SinhVien>) in.readObject();

    } catch (IOException | ClassNotFoundException e) {

        // Nếu file chưa tồn tại thì bỏ qua
        danhSach = new ArrayList<>();
    }
}
    
    private void lamMoi() {

    txtMasv.setText("");
    txtHovaten.setText("");
    txtLop.setText("");
    txtDiem.setText("");

    txtMasv.requestFocus();
}
    
    private boolean kiemTraDuLieu() {

    if (txtMasv.getText().trim().isEmpty()) {

        JOptionPane.showMessageDialog(
            this,
            "Vui lòng nhập mã sinh viên!"
        );

        txtMasv.requestFocus();

        return false;
    }

    if (txtHovaten.getText().trim().isEmpty()) {

        JOptionPane.showMessageDialog(
            this,
            "Vui lòng nhập họ tên!"
        );

        txtHovaten.requestFocus();

        return false;
    }

    if (txtLop.getText().trim().isEmpty()) {

        JOptionPane.showMessageDialog(
            this,
            "Vui lòng nhập lớp!"
        );

        txtLop.requestFocus();

        return false;
    }

    if (txtDiem.getText().trim().isEmpty()) {

        JOptionPane.showMessageDialog(
            this,
            "Vui lòng nhập điểm!"
        );

        txtDiem.requestFocus();

        return false;
    }

    try {

        double diem =
            Double.parseDouble(txtDiem.getText());

        if (diem < 0 || diem > 10) {

            JOptionPane.showMessageDialog(
                this,
                "Điểm phải từ 0 đến 10!"
            );

            txtDiem.requestFocus();

            return false;
        }

    } catch (NumberFormatException e) {

        JOptionPane.showMessageDialog(
            this,
            "Điểm phải là số!"
        );

        txtDiem.requestFocus();

        return false;
    }

    return true;
}

    private void hienThiDanhSach() {

    DefaultTableModel model =
        (DefaultTableModel) tblSinhvien.getModel();

    model.setRowCount(0);

    for (SinhVien sv : danhSach) {

        model.addRow(new Object[]{
            sv.getMaSV(),
            sv.getHoTen(),
            sv.getLop(),
            sv.getDiem()
        });
    }
}
    
