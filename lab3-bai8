    private void btnSuaActionPerformed(java.awt.event.ActionEvent evt) {                                       
         int dong = tblSinhvien.getSelectedRow();

        if (dong == -1) {

            JOptionPane.showMessageDialog(
                this,
                "Vui lòng chọn sinh viên cần sửa!"
            );

            return;
        }

        if (!kiemTraDuLieu()) {
            return;
        }

        String maSV = txtMasv.getText().trim();
        String hoTen = txtHovaten.getText().trim();
        String lop = txtLop.getText().trim();
        double diem = Double.parseDouble(txtDiem.getText());

        SinhVien sv = danhSach.get(dong);

        sv.setMaSV(maSV);
        sv.setHoTen(hoTen);
        sv.setLop(lop);
        sv.setDiem(diem);
        
        luuDuLieu();
        
        hienThiDanhSach();

        JOptionPane.showMessageDialog(
            this,
            "Sửa sinh viên thành công!"
        );

        lamMoi();
    }                                      

    private void btnThemActionPerformed(java.awt.event.ActionEvent evt) {                                        
             if (!kiemTraDuLieu()) {
            return;
        }

        String maSV = txtMasv.getText().trim();
        String hoTen = txtHovaten.getText().trim();
        String lop = txtLop.getText().trim();
        double diem = Double.parseDouble(txtDiem.getText());

        for (SinhVien sv : danhSach) {

            if (sv.getMaSV().equalsIgnoreCase(maSV)) {

                JOptionPane.showMessageDialog(
                    this,
                    "Mã sinh viên đã tồn tại!"
                );

                return;
            }
        }

        SinhVien sv =
            new SinhVien(maSV, hoTen, lop, diem);

        danhSach.add(sv);
        
        luuDuLieu();
        
        hienThiDanhSach();

        JOptionPane.showMessageDialog(
            this,
            "Thêm sinh viên thành công!"
        );

        lamMoi();
    }                                       

    private void btnXoaActionPerformed(java.awt.event.ActionEvent evt) {                                       
        int dong = tblSinhvien.getSelectedRow();

        if (dong == -1) {

            JOptionPane.showMessageDialog(
                this,
                "Vui lòng chọn sinh viên cần xóa!"
            );

            return;
        }

        int luaChon = JOptionPane.showConfirmDialog(
            this,
            "Bạn có chắc muốn xóa sinh viên này không?",
            "Xác nhận",
            JOptionPane.YES_NO_OPTION
        );

        if (luaChon == JOptionPane.YES_OPTION) {

            danhSach.remove(dong);
            
            luuDuLieu();
            
            hienThiDanhSach();

            JOptionPane.showMessageDialog(
                this,
                "Xóa sinh viên thành công!"
            );

            lamMoi();
        }
    }                                      

    private void btnLammoiActionPerformed(java.awt.event.ActionEvent evt) {                                          
        lamMoi();
    }                                         

    private void tblSinhvienMouseClicked(java.awt.event.MouseEvent evt) {                                         
        int dong = tblSinhvien.getSelectedRow();

        if (dong >= 0) {

            txtMasv.setText(
                tblSinhvien.getValueAt(dong, 0).toString()
            );

            txtHovaten.setText(
                tblSinhvien.getValueAt(dong, 1).toString()
            );

            txtLop.setText(
                tblSinhvien.getValueAt(dong, 2).toString()
            );

            txtDiem.setText(
                tblSinhvien.getValueAt(dong, 3).toString()
            );
        }
    }                                        

