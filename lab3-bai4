    private void btnKiemtraActionPerformed(java.awt.event.ActionEvent evt) {                                           
                    
        try {

            double a = Double.parseDouble(txtcanha.getText());
            double b = Double.parseDouble(txtcanhb.getText());
            double c = Double.parseDouble(txtcanhc.getText());

            if (a <= 0 || b <= 0 || c <= 0
                    || a + b <= c
                    || a + c <= b
                    || b + c <= a) {

                JOptionPane.showMessageDialog(
                        this,
                        "Ba canh khong tao thanh tam giac!",
                        "Ket qua",
                        JOptionPane.WARNING_MESSAGE
                );

            } else {
                String ketQua;

                if (a == b && b == c) {

                    ketQua = "Tam giac deu";

                }
                else if (a * a + b * b == c * c
                        || a * a + c * c == b * b
                        || b * b + c * c == a * a) {

                    ketQua = "Tam giác vuong";

                }
                else if (a == b || a == c || b == c) {

                    ketQua = "Tam giac can";

                }
                else {

                    ketQua = "Tam giac thuong";
                }

                JOptionPane.showMessageDialog(
                        this,
                        ketQua,
                        "Ket qua",
                        JOptionPane.INFORMATION_MESSAGE
                );
            }

        } catch (NumberFormatException e) {

            JOptionPane.showMessageDialog(
                    this,
                    "Vui long nhap 3 canh là s!",
                    "Loi",
                    JOptionPane.ERROR_MESSAGE
            );
        }
    }                                          

